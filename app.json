{
  "expo": {
    "name": "슬랩왕 쌀알이 키우기",
    "slug": "ssal-slap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF6E9",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF6E9"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.ssalslap.mobile",
      "buildNumber": "3"
    },
    "android": {
      "package": "app.ssalslap.mobile",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF6E9"
      }
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-iap",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1447190695017955~3380440406",
          "iosAppId": "ca-app-pub-1447190695017955~8054062444",
          "delayAppMeasurementInit": true
        }
      ]
    ]
  }
}